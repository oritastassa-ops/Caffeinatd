# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment files — never commit secrets.
# Ignore EVERY .env variant, then re-allow only the template. A narrow list
# missed .env.backup-provider once and GitHub push protection caught it; this
# pattern makes that class of mistake impossible.
.env*
!.env.example

# Vercel
.vercel

# TypeScript build cache
*.tsbuildinfo
next-env.d.ts

# Test artifacts
coverage/

# Logs
*.log
npm-debug.log*

# Editor / IDE
.vscode/
.idea/

# Claude Code local settings (may contain machine-specific paths)
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
