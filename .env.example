# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; used by cron

# ── AI provider ───────────────────────────────────────────────────────────────
# One of: gemini | openai | anthropic | openrouter | nim | ollama
AI_PROVIDER=gemini

# Gemini (default): https://aistudio.google.com/apikey — free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI-compatible providers (openai / openrouter / nim / ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA NIM: OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1  (key can be "ollama")

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Google Calendar OAuth (Google Cloud Console → Credentials) ───────────────
# Redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CRON_SECRET=generate-a-long-random-string

# 32-byte hex key used to encrypt third-party API keys (e.g. Hevy) at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Notifications ─────────────────────────────────────────────────────────────
# How off-app messages are delivered. `logging` (default) writes every send to
# the server log and returns a synthetic id — zero-cost, no vendor, exercises the
# whole path in dev/CI. Phases 2/3 add real drivers (Resend for email, Twilio for
# SMS) selected here.
NOTIFICATIONS_DRIVER=logging

# Optional pepper for hashing 6-digit verification codes (HMAC-SHA256). If unset,
# ENCRYPTION_KEY is used. Set a distinct value to avoid reusing the at-rest key.
# Generate with: openssl rand -hex 32
NOTIFICATION_SECRET=

# Phase 2 — Email (Resend): https://resend.com/api-keys
# RESEND_API_KEY=
# NOTIFICATIONS_FROM_EMAIL=you@your-domain.com

# Phase 3 — SMS (Twilio): https://console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...            # E.164
# NOTIFICATIONS_SMS_MONTHLY_CAP=100   # per-user hard cap, enforced against notification_spend
