# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; used by cron

# ── AI provider ───────────────────────────────────────────────────────────────
# One of: gemini | openai | anthropic | openrouter | nim | ollama
AI_PROVIDER=gemini

# Gemini (default): https://aistudio.google.com/apikey — free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI-compatible providers (openai / openrouter / nim / ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA NIM: OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1  (key can be "ollama")

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Google Calendar OAuth (Google Cloud Console → Credentials) ───────────────
# Redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CRON_SECRET=generate-a-long-random-string

# 32-byte hex key used to encrypt third-party API keys (e.g. Hevy) at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Notifications ─────────────────────────────────────────────────────────────
# How off-app messages are delivered:
#   logging (default) — writes every send to the server log and returns a
#     synthetic id. Zero-cost, no vendor; exercises the whole path in dev/CI.
#   live — assembles real channels from the vendor creds below. A channel whose
#     creds are absent is simply not registered (email works, SMS degrades).
NOTIFICATIONS_DRIVER=logging

# Optional pepper for hashing verification codes and signing unsubscribe links
# (HMAC-SHA256). If unset, ENCRYPTION_KEY is used. Set a distinct value to avoid
# reusing the at-rest key. Generate with: openssl rand -hex 32
NOTIFICATION_SECRET=

# Phase 2 — Email (Resend): https://resend.com/api-keys
# Requires NOTIFICATIONS_DRIVER=live. Both vars must be set or email stays off.
RESEND_API_KEY=
# The verified sender. The DOMAIN must be verified in Resend (SPF + DKIM DNS
# records) — mail from an unverified domain is unauthenticated and Gmail/Outlook
# route it straight to spam. Format: "Name <you@your-verified-domain.com>".
NOTIFICATIONS_FROM_EMAIL=

# Phase 3 — SMS (Twilio): https://console.twilio.com
# Requires NOTIFICATIONS_DRIVER=live. Needs the account creds plus a sender.
# COMPLIANCE: US A2P traffic requires A2P 10DLC brand + campaign registration
# BEFORE production sending — it takes DAYS to approve and unregistered traffic
# is filtered/blocked by carriers. Toll-free numbers are an alternative but still
# require toll-free verification (also days). Plan for the lead time; do not
# discover it at launch.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Prefer a Messaging Service SID (handles number pooling + compliance routing);
# a bare From number works too. Set one of these two:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=              # E.164, e.g. +14155550123

# Point the Messaging Service / number webhook at:
#   {APP_URL}/api/notifications/sms/inbound   (status callbacks + STOP/START/HELP)

# Accept a national-format number for this ISO 3166-1 region (e.g. US, GB); leave
# blank to require full +E.164 input. Used by the phone-number parser.
NOTIFICATIONS_DEFAULT_REGION=US

# Per-user SMS spend caps (defaults; overridable per user in notification_preferences).
# Over cap, an SMS is downgraded to email when possible, else recorded as skipped.
SMS_DAILY_CAP=10
SMS_MONTHLY_CAP=100
# Global backstop: max SMS actually sent per worker run (runaway-loop defense).
SMS_MAX_PER_RUN=200
